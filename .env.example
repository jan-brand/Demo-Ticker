DATABASE_URL=postgres://demo_ticker:demo_ticker@localhost:5432/demo_ticker
# Set this to the official all.json endpoint before running a live import.
ASSEMBLIES_API_URL=https://www.berlin.de/polizei/service/versammlungsbehoerde/versammlungen-aufzuege/index.php/index/all.json?q=
# Optional: import a saved API response instead of making an HTTP request.
# IMPORT_FILE=./data/all.json
# Interval of `npm run import:schedule` in minutes (default 60).
# IMPORT_INTERVAL_MINUTES=60

# Impressum and privacy policy (required before the site goes public).
# LEGAL_NAME=
# LEGAL_STREET=
# LEGAL_CITY=10115 Berlin
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_HOSTING=Hosting provider and whether it keeps access logs

# HTTPS: either let Node terminate TLS ...
# TLS_CERT_FILE=./certs/fullchain.pem
# TLS_KEY_FILE=./certs/privkey.pem
# ... or run behind a TLS proxy and redirect plain HTTP.
# FORCE_HTTPS=1
# TRUST_PROXY=1

# Public address, used for absolute links in /feed.xml.
# PUBLIC_URL=https://ticker.example.org
# Host port of the app container (`docker compose --profile app up -d`).
# APP_PORT=3000
